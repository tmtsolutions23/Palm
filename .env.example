# Copy to .env.local at root, mobile/.env, and backend/.env.local as appropriate.
# Mobile uses EXPO_PUBLIC_* prefix to expose to client. Backend uses NEXT_PUBLIC_* for client-side.

# ============================================================
# Supabase
# ============================================================
# Public (mobile + backend client)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...

# Backend-only (NEVER expose to mobile)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# ============================================================
# Anthropic (backend only)
# ============================================================
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_VISION=claude-sonnet-4-6
ANTHROPIC_MODEL_DAILY=claude-haiku-4-5-20251001

# ============================================================
# RevenueCat
# ============================================================
# Public mobile API keys (separate per platform)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_...
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_...

# Webhook auth (backend only)
REVENUECAT_WEBHOOK_AUTH=Bearer YOUR_RANDOM_SHARED_SECRET

# ============================================================
# Apple Sign In
# ============================================================
# Apple credentials (Services ID, Team ID, Key ID, .p8 private key) are
# configured in the Supabase dashboard under Auth > Providers > Apple, not
# in environment variables. The mobile client uses
# supabase.auth.signInWithIdToken() to authenticate.

# ============================================================
# Sentry
# ============================================================
EXPO_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_DSN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=sntrys_...
SENTRY_ORG=palmreader
SENTRY_PROJECT_MOBILE=palmreader-mobile
SENTRY_PROJECT_BACKEND=palmreader-backend

# ============================================================
# PostHog
# ============================================================
EXPO_PUBLIC_POSTHOG_KEY=phc_...
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=phc_...

# ============================================================
# Resend (transactional email)
# ============================================================
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Palm Reader <hello@palmreader.app>

# ============================================================
# Vercel Cron / internal job auth
# ============================================================
CRON_SECRET=long_random_string_for_authorizing_cron_endpoints

# ============================================================
# Upstash Redis (rate limiter at scale)
# ============================================================
# Required at >1K paying users. Without these, the rate limiter falls back
# to per-instance in-memory and won't enforce limits across Vercel functions.
UPSTASH_REDIS_REST_URL=https://YOUR_INSTANCE.upstash.io
UPSTASH_REDIS_REST_TOKEN=AYxxxxx

# ============================================================
# Public app URLs
# ============================================================
NEXT_PUBLIC_APP_URL=https://palmreader.app
NEXT_PUBLIC_API_URL=https://api.palmreader.app
EXPO_PUBLIC_API_URL=https://api.palmreader.app
